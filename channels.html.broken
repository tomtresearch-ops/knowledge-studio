<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Channels - Knowledge Studio</title>
    <style>
        :root {
            color-scheme: dark;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0a0a0a;
            color: #ffffff;
            min-height: 100vh;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 32px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(10, 10, 10, 0.85);
            backdrop-filter: blur(8px);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #8b5cf6, #a855f7);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 700;
        }

        .logo-text h1 {
            font-size: 20px;
            font-weight: 600;
        }

        .nav {
            display: flex;
            gap: 28px;
        }

        .nav a {
            color: #a1a1aa;
            font-weight: 500;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .nav a:hover {
            color: #ffffff;
            transform: translateY(-1px);
        }

        .nav a.active {
            color: #8b5cf6;
        }

        .page {
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px;
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 24px;
        }

        .panel {
            background: rgba(20, 20, 40, 0.75);
            border: 1px solid rgba(139, 92, 246, 0.1);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 20px 40px rgba(15, 15, 25, 0.35);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .panel h2 {
            font-size: 20px;
            font-weight: 600;
            color: #f5f5ff;
        }

        .panel h3 {
            font-size: 16px;
            font-weight: 600;
            color: #c4b5fd;
        }

        .subtitle {
            color: #a1a1aa;
            font-size: 14px;
        }

        .input-group {
            display: flex;
            gap: 12px;
        }

        .input {
            flex: 1;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid rgba(139, 92, 246, 0.2);
            background: rgba(15, 15, 30, 0.85);
            color: #f5f5ff;
        }

        .input:focus {
            outline: none;
            border-color: rgba(139, 92, 246, 0.6);
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
        }

        .button {
            background: linear-gradient(135deg, #8b5cf6, #a855f7);
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            font-weight: 600;
            color: #ffffff;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .button:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(139, 92, 246, 0.25);
        }

        .button.secondary {
            background: rgba(139, 92, 246, 0.15);
            color: #c4b5fd;
        }

        .button.secondary:hover {
            background: rgba(139, 92, 246, 0.25);
        }

        .button.destructive {
            background: rgba(220, 38, 38, 0.15);
            color: #f87171;
        }

        .button[disabled] {
            opacity: 0.5;
            cursor: default;
            box-shadow: none;
            transform: none;
        }

        .list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
            max-height: 60vh;
            padding-right: 4px;
        }

        .list::-webkit-scrollbar {
            width: 6px;
        }

        .list::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.35);
            border-radius: 999px;
        }

        .subscription-card {
            border: 1px solid rgba(139, 92, 246, 0.1);
            border-radius: 12px;
            padding: 14px;
            background: rgba(15, 15, 30, 0.75);
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: border-color 0.2s ease, transform 0.2s ease;
            cursor: pointer;
        }

        .subscription-card:hover {
            border-color: rgba(139, 92, 246, 0.4);
            transform: translateY(-1px);
        }

        .subscription-card.active {
            border-color: rgba(139, 92, 246, 0.8);
            background: rgba(30, 20, 65, 0.85);
        }

        .subscription-card.expanded {
            border-color: rgba(139, 92, 246, 0.6);
        }

        .subscription-videos-section {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid rgba(139, 92, 246, 0.2);
            display: none;
        }

        .subscription-card.expanded .subscription-videos-section {
            display: block;
        }

        .subscription-videos-controls {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 12px;
            align-items: center;
        }

        .subscription-videos-controls .input,
        .subscription-videos-controls select,
        .subscription-videos-controls .button {
            font-size: 12px;
            padding: 6px 10px;
        }

        .subscription-videos-table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 8px;
            font-size: 13px;
        }

        .subscription-videos-table th,
        .subscription-videos-table td {
            padding: 8px 10px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.08);
            text-align: left;
        }

        .subscription-videos-table th {
            background: rgba(139, 92, 246, 0.1);
            color: #d1c4ff;
            font-weight: 600;
            font-size: 12px;
        }

        .subscription-videos-table tbody tr:hover {
            background: rgba(139, 92, 246, 0.05);
        }

        .subscription-videos-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            padding: 12px;
            padding-top: 16px;
            border-top: 2px solid rgba(139, 92, 246, 0.2);
            background: rgba(139, 92, 246, 0.05);
            border-radius: 8px;
            gap: 12px;
            position: sticky;
            bottom: 0;
            z-index: 5;
            backdrop-filter: blur(8px);
        }

        .subscription-videos-actions-top {
            display: none; /* Hidden by default */
            position: sticky;
            top: 0;
            z-index: 6;
            background: rgba(20, 20, 40, 0.95);
            border-bottom: 2px solid rgba(139, 92, 246, 0.3);
            padding: 10px 12px;
            margin-bottom: 12px;
            border-radius: 8px;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(10px);
        }

        .subscription-videos-actions-top.has-selections {
            display: flex;
        }

        .subscription-videos-actions .button {
            font-size: 13px;
            padding: 8px 16px;
            font-weight: 600;
        }

        .subscription-videos-actions .button:not(.secondary) {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
        }

        .subscription-videos-actions .button:not(.secondary):hover {
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(139, 92, 246, 0.4);
        }

        .expand-icon {
            margin-left: 8px;
            transition: transform 0.2s ease;
            display: inline-block;
        }

        .subscription-card.expanded .expand-icon {
            transform: rotate(90deg);
        }

        .subscription-meta {
            color: #9ca3af;
            font-size: 12px;
        }

        .subscription-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
        }

        .filter-bar select {
            background: rgba(15, 15, 30, 0.85);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 10px;
            padding: 10px 12px;
            color: #e5e7eb;
        }

        .video-table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 12px;
            border-radius: 12px;
            overflow: hidden;
        }

        .video-table th, .video-table td {
            padding: 12px 14px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.08);
            text-align: left;
            font-size: 14px;
        }

        .video-table th {
            background: rgba(139, 92, 246, 0.12);
            color: #d1c4ff;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .video-table tbody tr:hover {
            background: rgba(139, 92, 246, 0.08);
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pill.processed {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }

        .status-pill.pending {
            background: rgba(254, 211, 48, 0.15);
            color: #fcd34d;
        }

        .status-pill.failed {
            background: rgba(239, 68, 68, 0.15);
            color: #fca5a5;
        }
        .status-pill.duration {
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
        }

        .queue-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            overflow-y: auto;
            max-height: 50vh;
            padding-right: 4px;
        }

        .queue-item {
            border: 1px solid rgba(139, 92, 246, 0.12);
            border-radius: 10px;
            padding: 12px;
            background: rgba(15, 15, 30, 0.85);
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .queue-item-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .queue-actions {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }

        .queue-summary {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .summary-card {
            background: rgba(139, 92, 246, 0.12);
            border-radius: 10px;
            padding: 12px;
        }

        .summary-label {
            font-size: 12px;
            color: #c4b5fd;
        }

        .summary-value {
            font-size: 18px;
            font-weight: 700;
        }

        .alert {
            padding: 12px 14px;
            border-radius: 10px;
            font-size: 14px;
            background: rgba(34, 197, 94, 0.1);
            color: #bbf7d0;
            border: 1px solid rgba(34, 197, 94, 0.3);
        }

        .alert.error {
            background: rgba(239, 68, 68, 0.12);
            color: #fecaca;
            border-color: rgba(248, 113, 113, 0.4);
        }

        .empty-state {
            padding: 24px;
            border: 1px dashed rgba(139, 92, 246, 0.3);
            border-radius: 12px;
            color: #9ca3af;
            text-align: center;
        }

        @media (max-width: 1200px) {
            .page {
                grid-template-columns: 1fr;
            }

            .panel {
                max-height: none;
            }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="logo">
            <div class="logo-icon">📡</div>
            <div class="logo-text">
                <h1>Channel Monitor</h1>
                <p class="subtitle">Discover → Queue → Summarize</p>
            </div>
        </div>
        <nav class="nav">
            <a href="/">Capture</a>
            <a href="/library">Library</a>
            <a href="/channels" class="active">Channels</a>
            <a href="/intelligence">Intelligence</a>
            <a href="/stats">Stats</a>
        </nav>
    </header>

    <main class="page">
        <!-- Tabs -->
        <div style="grid-column: 1 / -1; margin-bottom: 20px;">
            <div style="display: flex; gap: 12px; border-bottom: 2px solid rgba(139, 92, 246, 0.2); align-items: center;">
                <button id="youtubeTab" class="tab-button active" style="background: none; border: none; color: #8b5cf6; font-weight: 600; padding: 12px 20px; cursor: pointer; border-bottom: 2px solid #8b5cf6; margin-bottom: -2px;">📺 YouTube Channels</button>
                <button id="newsletterTab" class="tab-button" style="background: none; border: none; color: #a1a1aa; font-weight: 600; padding: 12px 20px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px;">📧 Newsletters</button>
                <button id="podcastTab" class="tab-button" style="background: none; border: none; color: #a1a1aa; font-weight: 600; padding: 12px 20px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px;">🎵 Podcasts</button>
                <button id="interviewTab" class="tab-button" style="background: none; border: none; color: #a1a1aa; font-weight: 600; padding: 12px 20px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px;">🎤 Search Interviews</button>
                <div style="flex: 1;"></div>
                <button id="refreshAllBtn" onclick="refreshAllFeeds()" class="button" style="padding: 8px 16px; font-size: 13px; margin-bottom: 6px;">🔄 Refresh All Feeds</button>
            </div>
        </div>

        <!-- YouTube Channels Panel -->
        <section class="panel" id="youtubePanel">
            <div>
                <h2>Channel Subscriptions</h2>
                <p class="subtitle">Click a channel to view its videos. Add public channels via URL, handle, or channel ID</p>
            </div>
            <form id="addSubscriptionForm" class="input-group">
                <input type="text" id="channelInput" class="input" placeholder="https://www.youtube.com/@channel or UCxxxx" required>
                <button type="submit" class="button">Subscribe</button>
            </form>
            <div style="margin-top: 12px;">
                <button id="cleanupShortsBtn" class="button secondary" onclick="cleanupShorts()" style="width: 100%;">
                    🧹 Remove All Shorts from Subscriptions
                </button>
            </div>
            <div id="subscriptionList" class="list">
                <div class="empty-state">No subscriptions yet. Add a channel to begin.</div>
            </div>
        </section>

        <!-- Newsletters Panel -->
        <section class="panel" id="newsletterPanel" style="display: none;">
            <div>
                <h2>Newsletter Subscriptions</h2>
                <p class="subtitle">Subscribe to newsletters by name or RSS/Substack/Beehiiv URL</p>
            </div>
            <form id="addNewsletterForm" class="input-group">
                <input type="text" id="newsletterInput" class="input" placeholder="Newsletter name (e.g., Stratechery) or URL" required>
                <button type="submit" class="button">Subscribe</button>
            </form>
            <div id="newsletterSubscriptionList" class="list">
                <div class="empty-state">No newsletter subscriptions yet. Add a newsletter to begin.</div>
            </div>
        </section>

        <!-- Podcasts Panel -->
        <section class="panel" id="podcastPanel" style="display: none;">
            <div>
                <h2>Podcast Subscriptions</h2>
                <p class="subtitle">Click a podcast to view its episodes. Add podcasts by name or RSS feed URL</p>
            </div>
            <form id="addPodcastForm" class="input-group">
                <input type="text" id="podcastInput" class="input" placeholder="Podcast name (e.g., Lex Fridman Podcast) or RSS URL" required>
                <button type="submit" class="button">Subscribe</button>
            </form>
            <div id="podcastSubscriptionList" class="list">
                <div class="empty-state">No podcast subscriptions yet. Add a podcast to begin.</div>
            </div>
        </section>

        <!-- Interview Search Panel -->
        <section class="panel" id="interviewPanel" style="display: none;">
            <div>
                <h2>Person Subscriptions</h2>
                <p class="subtitle">Subscribe to people to automatically discover and track their interviews across YouTube.</p>
            </div>
            
            <!-- Subscribed People List -->
            <div id="personSubscriptionsList" class="list" style="margin-bottom: 24px;">
                <div class="empty-state">No person subscriptions yet. Search for someone to subscribe.</div>
            </div>
            
            <!-- Search Section -->
            <div style="border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 20px; margin-top: 20px;">
                <h3 style="font-size: 16px; margin-bottom: 12px;">Search for Interviews</h3>
                <form id="searchInterviewsForm" class="input-group">
                    <input type="text" id="personNameInput" class="input" placeholder="Person name (e.g., Mo Gawdat, Lex Fridman)" required>
                    <button type="submit" class="button">Search</button>
                </form>
            </div>
            
            <!-- Search Results -->
            <div id="interviewResults" style="margin-top: 20px;">
                <div class="empty-state">Enter a person's name to search for interviews.</div>
            </div>
        </section>


        <aside class="panel" id="queuePanel">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <h2>Processing Queue</h2>
                <div style="display:flex;gap:8px;">
                    <button class="button secondary" id="pauseQueueBtn">Pause</button>
                    <button class="button secondary" id="resumeQueueBtn">Resume</button>
                </div>
            </div>
            <div class="queue-summary" id="queueSummary">
                <div class="summary-card">
                    <div class="summary-label">Queued</div>
                    <div class="summary-value" data-summary="queued">0</div>
                </div>
                <div class="summary-card">
                    <div class="summary-label">Processing</div>
                    <div class="summary-value" data-summary="processing">0</div>
                </div>
                <div class="summary-card">
                    <div class="summary-label">Completed</div>
                    <div class="summary-value" data-summary="completed">0</div>
                </div>
                <div class="summary-card">
                    <div class="summary-label">Failed</div>
                    <div class="summary-value" data-summary="failed">0</div>
                </div>
            </div>
            <div id="queuePausedBanner" class="alert error" style="display:none;">
                Queue processing is paused.
            </div>
            <div id="queueList" class="queue-list">
                <div class="empty-state">Queue is empty.</div>
            </div>
        </aside>
    </main>

    <div id="alerts" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);max-width:480px;display:flex;flex-direction:column;gap:12px;"></div>

    <script>
        const state = {
            subscriptions: [],
            selectedSubscriptionId: null,
            selectedChannelId: null,
            expandedSubscriptionId: null, // Track which subscription is expanded
            videos: [], // Videos for currently expanded subscription
            videosByChannel: {}, // Cache videos by channel_id
            selectedVideoIds: new Set(),
            searchTerms: {}, // Search terms per channel
            videoFilters: {}, // Filter per channel (all/processed/unprocessed)
            historyRanges: {}, // History range per channel (latest/3/6/12/all)
            queueItems: [],
            queueState: {},
            isLoadingSubscriptions: false,
            isLoadingVideos: {},
            isLoadingQueue: false,
            // Podcast state
            podcastSubscriptions: [],
            expandedPodcastId: null,
            episodesByPodcast: {},
            selectedEpisodeIds: new Set(),
            isLoadingPodcasts: false,
            isLoadingEpisodes: {},
            processingEpisodes: new Set(), // Track episodes currently being processed
            currentTab: 'youtube', // 'youtube', 'newsletter', 'podcast', or 'interview'
            queueItems: {}, // Track queue items by episode_id: {progress_percent, stage, status}
            selectedEpisodeIds: new Set(), // Track selected podcast episodes for bulk processing
            // Newsletter state
            newsletterSubscriptions: [],
            expandedNewsletterId: null,
            issuesByNewsletter: {},
            selectedIssueIds: new Set(),
            isLoadingNewsletters: false,
            isLoadingIssues: {},
        };

        const alertsContainer = document.getElementById('alerts');

        function getPromptLabel(promptCode) {
            const promptMap = {
                'interview': '🎤 Interview Analysis',
                'crypto': '💰 Crypto/Finance Analysis',
                'news': '📰 News Analysis',
                'genai_tools': '🤖 AI Tools Analysis',
                'health_explainer': '🏥 Health Analysis',
                'general': '📝 General Analysis',
                'error': '❌ Error'
            };
            return promptMap[promptCode] || `📝 ${promptCode}`;
        }

        function formatDocumentDate(dateString) {
            if (!dateString) return 'Unknown date';
            const parsed = new Date(dateString);
            if (Number.isNaN(parsed.getTime())) return dateString;
            return parsed.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });
        }

        function renderMarkdown(text) {
            if (!text) return '';
            
            if (text.includes('<li') || text.includes('<ul') || text.includes('<ol')) {
                text = text.replace(/<li([^>]*)(?![^>]*style=)([^>]*)>/gi, '<li$1$2 style="margin: 0.5em 0; color: #e5e7eb; line-height: 1.7; padding-left: 0;">');
                text = text.replace(/<li([^>]*)style="([^"]*)"/gi, function(match, attrs, styles) {
                    let newStyles = styles
                        .replace(/margin:\s*0\.0?5?rem[^;]*;?/gi, 'margin: 0.5em 0;')
                        .replace(/margin:\s*0\.1rem[^;]*;?/gi, 'margin: 0.5em 0;')
                        .replace(/margin:\s*[^;]*;?/gi, function(m) {
                            if (!m.includes('0.5em') && !m.includes('1em')) {
                                return 'margin: 0.5em 0;';
                            }
                            return m;
                        });
                    if (!newStyles.includes('margin: 0.5em')) {
                        newStyles = 'margin: 0.5em 0; ' + newStyles;
                    }
                    if (!newStyles.includes('line-height: 1.7')) {
                        newStyles = newStyles.replace(/line-height:\s*[^;]*;?/gi, '');
                        newStyles += ' line-height: 1.7;';
                    }
                    if (!newStyles.includes('color: #e5e7eb')) {
                        newStyles = newStyles.replace(/color:\s*[^;]*;?/gi, '');
                        newStyles += ' color: #e5e7eb;';
                    }
                    return '<li' + attrs + 'style="' + newStyles + '"';
                });
                
                text = text.replace(/<ul([^>]*)(?![^>]*style=)([^>]*)>/gi, '<ul$1$2 style="margin: 1em 0; padding-left: 30px; list-style: disc;">');
                text = text.replace(/<ol([^>]*)(?![^>]*style=)([^>]*)>/gi, '<ol$1$2 style="margin: 1em 0; padding-left: 30px;">');
                
                text = text.replace(/<ul([^>]*)style="([^"]*)"/gi, function(match, attrs, styles) {
                    let newStyles = styles
                        .replace(/margin:\s*0\.8rem[^;]*;?/gi, 'margin: 1em 0;')
                        .replace(/margin:\s*[^;]*;?/gi, function(m) {
                            if (!m.includes('1em')) {
                                return 'margin: 1em 0;';
                            }
                            return m;
                        })
                        .replace(/padding-left:\s*20px[^;]*;?/gi, 'padding-left: 30px;')
                        .replace(/padding-left:\s*25px[^;]*;?/gi, 'padding-left: 30px;');
                    if (!newStyles.includes('margin: 1em')) {
                        newStyles = 'margin: 1em 0; ' + newStyles;
                    }
                    if (!newStyles.includes('padding-left: 30px')) {
                        newStyles = newStyles.replace(/padding-left:\s*[^;]*;?/gi, '');
                        newStyles += ' padding-left: 30px;';
                    }
                    return '<ul' + attrs + 'style="' + newStyles + '"';
                });
                
                text = text.replace(/<ol([^>]*)style="([^"]*)"/gi, function(match, attrs, styles) {
                    let newStyles = styles
                        .replace(/margin:\s*0\.8rem[^;]*;?/gi, 'margin: 1em 0;')
                        .replace(/margin:\s*[^;]*;?/gi, function(m) {
                            if (!m.includes('1em')) {
                                return 'margin: 1em 0;';
                            }
                            return m;
                        })
                        .replace(/padding-left:\s*20px[^;]*;?/gi, 'padding-left: 30px;')
                        .replace(/padding-left:\s*25px[^;]*;?/gi, 'padding-left: 30px;');
                    if (!newStyles.includes('margin: 1em')) {
                        newStyles = 'margin: 1em 0; ' + newStyles;
                    }
                    if (!newStyles.includes('padding-left: 30px')) {
                        newStyles = newStyles.replace(/padding-left:\s*[^;]*;?/gi, '');
                        newStyles += ' padding-left: 30px;';
                    }
                    return '<ol' + attrs + 'style="' + newStyles + '"';
                });
                
                return text;
            }
            
            text = text.replace(/Here's a comprehensive extraction of the key insights from the transcript:/g, '');
            text = text.replace(/=== PART \d+ ===/g, '');
            text = text.replace(/\(Note: This format continues but I'll stop here for length.*?\)/g, '');
            text = text.replace(/\(Note:.*?\)/g, '');
            text = text.replace(/This format continues but I'll stop here for length.*?$/g, '');
            text = text.replace(/The structure follows your exact requirements.*?$/g, '');
            text = text.replace(/Let me know if you would like me to break down any other major sections.*?$/g, '');
            text = text.replace(/I notice this appears to be an extremely long raw transcript.*?\n\n/g, '');
            
            text = text
                .replace(/^## (EXECUTIVE SUMMARY.*$)/gim, '<h2 style="color: #8b5cf6; margin: 1.8em 0 0.6em 0; font-size: 22px; font-weight: 600; padding-bottom: 6px; border-bottom: 1px solid rgba(139, 92, 246, 0.3);">$1</h2>')
                .replace(/^## (STRUCTURED ANALYSIS.*$)/gim, '<h2 style="color: #8b5cf6; margin: 1.8em 0 0.6em 0; font-size: 22px; font-weight: 600; padding-bottom: 6px; border-bottom: 1px solid rgba(139, 92, 246, 0.3);">$1</h2>')
                .replace(/^## (CONCLUSION.*$)/gim, '<h2 style="color: #8b5cf6; margin: 1.8em 0 0.6em 0; font-size: 22px; font-weight: 600; padding-bottom: 6px; border-bottom: 1px solid rgba(139, 92, 246, 0.3);">$1</h2>')
                .replace(/^## (.*$)/gim, '<h2 style="color: #8b5cf6; margin: 1.8em 0 0.6em 0; font-size: 22px; font-weight: 600; padding-bottom: 6px; border-bottom: 1px solid rgba(139, 92, 246, 0.3);">$1</h2>')
                .replace(/^### ([IVX]+\.\s+.*$)/gm, '<h3 style="color: #a78bfa; margin: 1.4em 0 0.4em 0; font-size: 18px; font-weight: 600;">$1</h3>')
                .replace(/^### (.*$)/gim, '<h3 style="color: #a78bfa; margin: 1.4em 0 0.4em 0; font-size: 18px; font-weight: 600;">$1</h3>')
                .replace(/\*\*(.*?)\*\*/g, '<strong style="color: #ffffff; font-weight: 600;">$1</strong>')
                .replace(/\*(.*?)\*/g, '<em style="color: #e5e7eb;">$1</em>')
                .replace(/^(\d+)\. (.*)$/gm, '<li style="margin: 0.5em 0; color: #e5e7eb; line-height: 1.7; list-style: none; padding-left: 0;">$1. $2</li>')
                .replace(/^- (.*)$/gm, '<li style="margin: 0.5em 0; color: #e5e7eb; line-height: 1.7; padding-left: 0;">$1</li>')
                .replace(/^-([^-].*)$/gm, '<li style="margin: 0.5em 0; color: #e5e7eb; line-height: 1.7; padding-left: 0;">$1</li>')
                .replace(/((?:<li[^>]*>.*?<\/li>\s*)+)/g, function(match) {
                    if (match.includes('list-style: none')) {
                        return '<ul style="margin: 1em 0; padding-left: 30px; list-style: none;">' + match + '</ul>';
                    } else {
                        return '<ul style="margin: 1em 0; padding-left: 30px; list-style: disc;">' + match + '</ul>';
                    }
                })
                .replace(/\n\n+/g, '</p><p style="margin: 0.8em 0; line-height: 1.8; color: #e5e7eb;">')
                .replace(/^(?!<[hul])/gm, '<p style="margin: 0.8em 0; line-height: 1.8; color: #e5e7eb;">')
                .replace(/<p[^>]*>(<[hul][^>]*>.*?<\/[hul]>)<\/p>/g, '$1')
                .replace(/<p[^>]*><\/p>/g, '')
                .replace(/^<p[^>]*>/, '')
                .replace(/<\/p>$/, '');
            
            return text;
        }

        async function openProcessedDocument(videoId) {
            // Open window immediately (synchronously) to avoid popup blocker
            const windowWidth = Math.min(900, window.screen.width - 100);
            const windowHeight = window.screen.height - 100;
            const docWindow = window.open('', '_blank', `width=${windowWidth},height=${windowHeight},scrollbars=yes`);
            if (!docWindow) {
                showAlert('Please allow popups to view document format. You can also navigate to the Library page and click the video there.', 'error');
                return;
            }
            
            // Show loading message
            docWindow.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Loading...</title>
                    <meta charset="UTF-8">
                    <style>
                        body {
                            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                            background: #1a1a1a;
                            color: #ffffff;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            height: 100vh;
                            margin: 0;
                        }
                        .loading {
                            text-align: center;
                        }
                    </style>
                </head>
                <body>
                    <div class="loading">
                        <h2>Loading document...</h2>
                        <p>Please wait</p>
                    </div>
                </body>
                </html>
            `);
            docWindow.document.close();
            
            try {
                const response = await fetch(`http://localhost:5001/api/videos/${videoId}`);
                const data = await response.json();
                if (!data.success) {
                    throw new Error(data.error || 'Unable to fetch video details.');
                }
                const video = data.video;
                const item = {
                    id: video.id,
                    title: video.title || 'Untitled Video',
                    channel: video.channel,
                    video_url: video.video_url,
                    url: video.url,
                    ai_summary: video.ai_summary,
                    summary: video.summary,
                    date: video.date || video.processing_date,
                    content_type: 'video',
                    favorited: !!video.favorited,
                    prompt_used: video.prompt_used
                };
                openDocumentWindow(item, docWindow);
            } catch (error) {
                console.error('openProcessedDocument error:', error);
                if (docWindow && !docWindow.closed) {
                    docWindow.document.write(`
                        <!DOCTYPE html>
                        <html>
                        <head>
                            <title>Error</title>
                            <meta charset="UTF-8">
                            <style>
                                body {
                                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                                    background: #1a1a1a;
                                    color: #ffffff;
                                    padding: 40px;
                                }
                            </style>
                        </head>
                        <body>
                            <h2>Error Loading Document</h2>
                            <p>${error.message || 'Unable to load document.'}</p>
                            <button onclick="window.close()" style="padding: 10px 20px; background: #8b5cf6; color: white; border: none; border-radius: 6px; cursor: pointer; margin-top: 20px;">Close</button>
                        </body>
                        </html>
                    `);
                    docWindow.document.close();
                }
                showAlert(error.message || 'Unable to open document.', 'error');
            }
        }

        function openDocumentWindow(item, docWindow = null) {
            // Handle null/undefined summary explicitly - check both fields
            console.log('openDocumentWindow called with item:', {
                id: item.id,
                title: item.title,
                ai_summary: item.ai_summary ? `[${item.ai_summary.length} chars]` : 'null',
                summary: item.summary ? `[${item.summary.length} chars]` : 'null'
            });
            
            let summaryContent = '';
            if (item.ai_summary && typeof item.ai_summary === 'string' && item.ai_summary.trim()) {
                summaryContent = item.ai_summary.trim();
            } else if (item.summary && typeof item.summary === 'string' && item.summary.trim()) {
                summaryContent = item.summary.trim();
            } else {
                summaryContent = 'No summary available';
            }
            
            console.log('Final summaryContent length:', summaryContent.length);
            const promptLabel = item.prompt_used ? getPromptLabel(item.prompt_used) : '';
            const formattedDate = formatDocumentDate(item.date);
            let urlHostname = '';
            if (item.url && item.url !== 'text-input') {
                try {
                    urlHostname = new URL(item.url).hostname;
                } catch (e) {
                    urlHostname = item.url;
                }
            }
            
            // Use provided window or open new one
            if (!docWindow) {
                const windowWidth = Math.min(900, window.screen.width - 100);
                const windowHeight = window.screen.height - 100;
                docWindow = window.open('', '_blank', `width=${windowWidth},height=${windowHeight},scrollbars=yes`);
                if (!docWindow || docWindow.closed || typeof docWindow.closed === 'undefined') {
                    // Popup blocked - fallback to opening article page in new tab
                    const articleId = item.id;
                    const articleUrl = `/api/articles/${articleId}`;
                    window.open(articleUrl, '_blank');
                    alert('Popup blocked. Opening article in a new tab instead.');
                    return;
                }
            }
            const renderedContent = renderMarkdown(summaryContent);
            const contentIcon = item.content_type === 'article' ? '📄' : (item.content_type === 'audio' ? '🎵' : '🎥');
            const favoriteUrl = item.content_type === 'article' || item.content_type === 'audio'
                ? `/api/articles/${item.id}/favorite`
                : `/api/videos/${item.id}/favorite`;
            docWindow.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>${item.title} - Knowledge Studio</title>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <style>
                        * {
                            margin: 0;
                            padding: 0;
                            box-sizing: border-box;
                        }
                        body {
                            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                            background: #1a1a1a;
                            color: #ffffff;
                            line-height: 1.7;
                            padding: 60px 80px;
                            max-width: 1000px;
                            margin: 0 auto;
                            cursor: pointer;
                        }
                        .content-wrapper {
                            cursor: default;
                        }
                        .top-bar {
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            gap: 16px;
                            margin-bottom: 24px;
                        }
                        .favorite-toggle {
                            border: none;
                            border-radius: 10px;
                            padding: 10px 16px;
                            font-weight: 600;
                            background: rgba(139, 92, 246, 0.18);
                            color: #c4b5fd;
                            cursor: pointer;
                            transition: background 0.2s ease, transform 0.2s ease;
                        }
                        .favorite-toggle:hover {
                            background: rgba(139, 92, 246, 0.28);
                            transform: translateY(-1px);
                        }
                        .favorite-toggle.is-favorited {
                            background: rgba(251, 191, 36, 0.22);
                            color: #facc15;
                        }
